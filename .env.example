API_KEY=replace-with-a-long-random-secret
AUTH_MODE=bearer
DATABASE_PATH=data/memory.db
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64
MAX_CONCURRENT_ENCODES=1
INCLUDE_OPTIONS_IN_QUERY=true
MAX_TOP_K=100
ENABLE_HYBRID_RETRIEVAL=true
LEXICAL_CANDIDATE_K=100
DENSE_WEIGHT=1.0
LEXICAL_WEIGHT=0.9
NEIGHBORHOOD_RADIUS=1
CONTEXT_EMBEDDING_RADIUS=2
CONTEXT_EMBEDDING_WEIGHT=0.3
NEIGHBOR_RESULT_RATIO=0.2
INDEX_WINDOW_ENABLED=true
INDEX_WINDOW_SIZE=6
INDEX_WINDOW_OVERLAP=2
WINDOW_RETRIEVAL_WEIGHT=0.7
CODE_RETRIEVAL_ENABLED=true
CODE_EXACT_MATCH_WEIGHT=0.08
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
